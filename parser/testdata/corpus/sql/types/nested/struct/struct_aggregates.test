CREATE VIEW struct_int AS
SELECT * FROM (VALUES
	({'x': 1, 'y': 0}),
	({'x': 1, 'y': 2}),
	({'x': 1, 'y': NULL}),
	({'x': NULL, 'y': 2}),
	({'x': NULL, 'y': NULL}),
	({'x': NULL, 'y': 0}),
	(NULL)
) tbl(i);
--
ok
