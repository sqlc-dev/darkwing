CREATE TABLE rle_secrets AS
    SELECT (i // 20000)::INTEGER AS grp, CASE WHEN i < 20000 THEN 100000 ELSE 5 END::INTEGER AS val
    FROM range(100000) t(i)
--
ok
==
SELECT count(*) > 0 FROM pragma_storage_info('rle_secrets') WHERE column_name = 'val' AND compression = 'RLE'
--
ok
==
CREATE SECURE VIEW rle_secure_view AS SELECT * FROM rle_secrets WHERE grp <> 0
--
ok
==
SELECT count(*) FROM rle_secure_view WHERE val::TINYINT = 5
--
ok
==
SELECT count(*) FROM rle_secrets WHERE grp <> 0 AND __internal_barrier(val::TINYINT = 5)
--
ok
