CREATE TABLE constant_numbers AS
SELECT i::INTEGER AS id,
       1::TINYINT AS i8,
       2::SMALLINT AS i16,
       3::UTINYINT AS u8,
       4::USMALLINT AS u16,
       5::UINTEGER AS u32,
       6::UBIGINT AS u64,
       7::HUGEINT AS i128,
       8::UHUGEINT AS u128,
       1.5::FLOAT AS f32,
       2.5::DOUBLE AS f64
FROM range(4096) r(i)
--
ok
==
SELECT DISTINCT compression
FROM pragma_storage_info('constant_numbers')
WHERE column_name <> 'id' AND segment_type <> 'VALIDITY'
--
ok
==
CREATE UNIQUE INDEX constant_numbers_id ON constant_numbers(id)
