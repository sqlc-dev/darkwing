SELECT 
	i,
	(i * 29) % 11 AS outside,
	first_value(i ORDER BY i DESC) OVER w,
	last_value(i ORDER BY i DESC) OVER w,
	nth_value(i, 2 ORDER BY i DESC) OVER w,
FROM range(10) tbl(i)
WINDOW w AS (
	ORDER BY (i * 29) % 11
	ROWS BETWEEN 3 PRECEDING AND 3 FOLLOWING
)
ORDER BY 2
