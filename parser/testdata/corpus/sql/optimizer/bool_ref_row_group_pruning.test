CREATE TABLE nullable_tb AS SELECT
  CASE WHEN range // 2048 = 0 THEN CASE WHEN range % 2 = 0 THEN TRUE ELSE NULL END
       WHEN range // 2048 = 1 THEN CASE WHEN range % 2 = 0 THEN FALSE ELSE NULL END
       WHEN range // 2048 = 2 THEN (range % 2 = 0)
       ELSE NULL END AS b
FROM range(8192);
--
ok
==
EXPLAIN ANALYZE SELECT count(*) FROM nullable_tb WHERE b;
--
ok
==
SELECT count(*) FROM nullable_tb WHERE b;
--
ok
==
EXPLAIN ANALYZE SELECT count(*) FROM nullable_tb WHERE NOT b;
--
ok
==
SELECT count(*) FROM nullable_tb WHERE NOT b;
--
ok
