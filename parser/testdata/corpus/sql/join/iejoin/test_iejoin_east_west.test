CREATE TABLE west AS SELECT * FROM (VALUES
    ('s1', 404, 100,  6, 4),
    ('s2', 498, 140, 11, 2),
    ('s3', 676,  80, 10, 1),
    ('s4', 742,  90,  5, 4)
) west(rid, t_id, time, cost, cores)
