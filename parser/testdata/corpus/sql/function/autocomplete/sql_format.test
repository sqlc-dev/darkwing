SELECT duckdb_format_sql('SELECT {''l_orderkey'': 1, ''l_partkey'': 155190, ''l_suppkey'': 7706, ''l_linenumber'': 1, ''l_quantity'': 17.00, ''l_extendedprice'': 21168.23, ''l_discount'': 0.04, ''l_tax'': 0.02, ''l_returnflag'': ''N'', ''l_linestatus'': ''O'', ''l_shipdate'': ''1996-03-13'', ''l_commitdate'': ''1996-02-12'', ''l_receiptdate'': ''1996-03-22'', ''l_shipinstruct'': ''DELIVER IN PERSON'', ''l_shipmode'': ''TRUCK'', ''l_comment'': ''to beans x-ray carefull''}') = $$SELECT
    {
            'l_orderkey': 1,
            'l_partkey': 155190,
            'l_suppkey': 7706,
            'l_linenumber': 1,
            'l_quantity': 17.00,
            'l_extendedprice': 21168.23,
            'l_discount': 0.04,
            'l_tax': 0.02,
            'l_returnflag': 'N',
