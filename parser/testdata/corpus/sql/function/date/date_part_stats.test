CREATE TABLE expected_result AS FROM (VALUES
	('year', 1992, 2000),
	('month', 1, 12),
	('day', 1, 31),
	('decade', 199, 200),
	('century', 20, 20),
	('millenium', 2, 2),
	('microseconds', 0, 59999999),
	('milliseconds', 0, 59999),
	('second', 0, 59),
	('minute', 0, 59),
	('hour', 0, 24),
	('dow', 0, 6),
	('week', 1, 53),
	('doy', 1, 366),
	('quarter', 1, 4),
	('yearweek', 199201, 200052),
	('dayofmonth', 1, 31),
	('weekday', 0, 6),
	('weekofyear', 1, 53)
	) t(component, min, max)
--
ok
==
SELECT
	CASE WHEN stats.min = expected_result.min AND stats.max = expected_result.max THEN NULL ELSE {'stats': stats, 'expected_result': expected_result} END
FROM (
	SELECT STATS(EXTRACT({component} FROM d)) AS stats, (SELECT expected_result FROM expected_result WHERE component = '{component}') expected_result FROM dates LIMIT 1
)
