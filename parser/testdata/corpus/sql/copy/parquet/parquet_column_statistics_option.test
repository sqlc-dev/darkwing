COPY (SELECT i AS id, (i % 25)::INTEGER AS nation, CASE WHEN i % 2 = 0 THEN NULL ELSE i END AS half, 'r_' || i AS name
      FROM range(100000) t(i))
TO '{TEST_DIR}/column_stats_1.parquet' (FORMAT parquet);
--
ok
==
COPY (SELECT i AS id, (i % 25)::INTEGER AS nation, CASE WHEN i % 2 = 0 THEN NULL ELSE i END AS half, 'r_' || i AS name
      FROM range(100000, 200000) t(i))
TO '{TEST_DIR}/column_stats_2.parquet' (FORMAT parquet);
--
ok
==
EXPLAIN SELECT id FROM read_parquet(['{TEST_DIR}/column_stats_1.parquet', '{TEST_DIR}/column_stats_2.parquet'])
WHERE id > 1000000;
--
ok
==
EXPLAIN SELECT id FROM read_parquet(['{TEST_DIR}/column_stats_1.parquet', '{TEST_DIR}/column_stats_2.parquet'],
    column_statistics := MAP {'id': MAP {'min': '0', 'max': '199999', 'count': '200000', 'null_count': '0', 'distinct_count': '200000'}})
WHERE id > 1000000;
--
ok
==
