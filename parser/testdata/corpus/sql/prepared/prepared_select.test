PREPARE s2 AS
SELECT FIRST(?::VARCHAR)
FROM (VALUES (?::INTEGER)) tbl(i)
WHERE i > ?::INTEGER
GROUP BY i % ?::INTEGER
HAVING SUM(i)::VARCHAR <> ?::VARCHAR
--
ok
==
EXECUTE s2('hello', 2, 1, 2, 'blabla')
--
ok
==
EXECUTE s2('hello', 2, 1, 2, '2')
--
ok
