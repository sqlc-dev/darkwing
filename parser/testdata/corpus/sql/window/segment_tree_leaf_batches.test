WITH input AS (
    SELECT i // 2053 AS p, i % 2053 AS j,
           CASE WHEN i % 2053 % 7 <> 0 THEN i % 2053 END AS v
    FROM range(131392) t(i)
), windowed AS (
    SELECT *, sum(v) FILTER (WHERE j % 3 <> 0) OVER (
        PARTITION BY p ORDER BY j ROWS BETWEEN 35 PRECEDING AND 17 FOLLOWING EXCLUDE CURRENT ROW
    ) AS actual
    FROM input
)
SELECT count(*) FROM windowed
WHERE coalesce(actual, 0) <> filtered_prefix(least(j + 17, 2052)) - filtered_prefix(greatest(j - 35, 0) - 1)
    - CASE WHEN j % 3 <> 0 AND j % 7 <> 0 THEN j ELSE 0 END
--
ok
==
SELECT count(*) FROM (
    SELECT i, min(i, (i // 2053) % 3 + 1) OVER (PARTITION BY i // 2053 ORDER BY i) AS actual
    FROM range(131392) t(i)
) t
WHERE actual IS DISTINCT FROM list_transform(range(least((i // 2053) % 3 + 1, i % 2053 + 1)), lambda x: (i // 2053) * 2053 + x)
