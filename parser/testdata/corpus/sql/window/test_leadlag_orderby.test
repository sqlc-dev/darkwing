SELECT
	id,
	x,
	LEAD(x ORDER BY x DESC, id DESC) OVER w,
	LEAD(x ORDER BY x DESC, id ASC) OVER w
FROM issue25699
WINDOW w AS (ORDER BY x DESC, id ASC ROWS BETWEEN 1 FOLLOWING AND UNBOUNDED FOLLOWING)
ORDER BY id;
