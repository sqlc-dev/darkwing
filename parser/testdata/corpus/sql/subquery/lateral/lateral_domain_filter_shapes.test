CREATE TABLE vertices AS SELECT i::INTEGER id FROM range(100) t(i);
--
ok
==
CREATE VIEW shape_union AS
SELECT input.id,w.depth FROM vertices input
CROSS JOIN LATERAL (
    WITH RECURSIVE walk(depth) AS (
        SELECT 0+input.id*0
        UNION
        SELECT depth+1 FROM walk WHERE depth<7
    )
    SELECT depth FROM walk
) w
JOIN vertices target ON target.id=w.depth+1;
--
ok
==
SELECT count(*) FROM shape_union WHERE id=3;
--
ok
==
EXPLAIN SELECT count(*) FROM shape_union WHERE id=3;
--
ok
