CREATE TABLE containers (
    kind INTEGER,
    l INTEGER[],
    s STRUCT(x INTEGER),
    m MAP(VARCHAR, INTEGER),
    a INTEGER[2]
);
--
ok
==
INSERT INTO containers VALUES
    (0, NULL, NULL, NULL, NULL),
    (1, [NULL], {'x': NULL}, MAP {'key': NULL}, [NULL, NULL]),
    (2, [], {'x': 42}, MAP {}, [42, 42]);
--
ok
==
WITH stats AS (
    COPY containers TO '{TEST_DIR}/container_stats'
    (FORMAT PARQUET, PARTITION_BY(kind), RETURN_STATS)
)
SELECT partition_keys['kind'],
       column_statistics['"l"'],
       column_statistics['"l"."element"']['null_count'],
       column_statistics['"s"'],
       column_statistics['"s"."x"']['null_count'],
       column_statistics['"m"'],
       column_statistics['"m"."value"']['null_count'],
       column_statistics['"a"'],
       column_statistics['"a"."element"']['null_count']
FROM stats;
--
ok
==
WITH stats AS (
    COPY containers TO '{TEST_DIR}/container_stats_flat.parquet' (RETURN_STATS)
)
SELECT UNNEST(map_keys(column_statistics)) FROM stats;
--
ok
