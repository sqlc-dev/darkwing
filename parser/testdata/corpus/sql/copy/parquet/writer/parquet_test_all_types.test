CREATE TABLE all_types AS
SELECT * EXCLUDE (bit, "union", empty_struct, tuple) REPLACE (
	case when extract(month from interval) <> 0 then interval '1 month 1 day 12:13:34.123' else interval end AS interval
)
FROM test_all_types();
