WITH binary_string as (select replace('{binary}', '_', '') as str)
SELECT 
	list_sum([ (CASE WHEN str[i+1] = '0' THEN 0 ELSE 1 END) * (2 ** (len(str)-(i+1))) for i in range(len(str))])::INT
	==
	'{prefix}{binary}'::INT
FROM binary_string
--
ok
==
