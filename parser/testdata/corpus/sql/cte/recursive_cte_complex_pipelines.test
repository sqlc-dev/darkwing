WITH RECURSIVE t AS
(
	SELECT 1 AS x
UNION
	SELECT t1.x + t2.x + t3.x AS x
	FROM t t1, t t2, t t3
	WHERE t1.x < 100
)
SELECT * FROM t ORDER BY 1;
--
ok
==
WITH RECURSIVE t AS
(
	SELECT 1 AS x
UNION
	SELECT (t1.x + t2.x + t3.x)::HUGEINT AS x
	FROM t t1, t t2, t t3
	WHERE t1.x < 100
)
SELECT * FROM t ORDER BY 1;
--
ok
