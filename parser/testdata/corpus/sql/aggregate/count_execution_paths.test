ok
==
SELECT sum(c) FROM (
    SELECT count(*) FILTER (WHERE i % 3 = 0) OVER (
        ORDER BY i ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING EXCLUDE CURRENT ROW
    ) AS c
    FROM range(10) t(i)
);
