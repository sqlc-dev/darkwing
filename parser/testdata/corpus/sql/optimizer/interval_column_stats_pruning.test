CREATE TABLE interval_pairs AS
SELECT (CASE range // 2048 WHEN 0 THEN 1 WHEN 1 THEN 1 ELSE 10 END) * INTERVAL '1 day' AS a,
       (CASE range // 2048 WHEN 0 THEN 10 WHEN 1 THEN 10 ELSE 1 END) * INTERVAL '1 day' AS b
FROM range(6144);
