CREATE TABLE prefix_nullable_mixed AS
SELECT CASE
           WHEN range < 2048 THEN CASE WHEN range % 2 = 0 THEN 'abc' ELSE NULL END
           WHEN range < 4096 THEN 'zzz'
           ELSE 'abc'
       END::VARCHAR AS s
FROM range(6144)
--
ok
==
SELECT count(*) FROM prefix_nullable_mixed WHERE NOT prefix(s, 'a')
