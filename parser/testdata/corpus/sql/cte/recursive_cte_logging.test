WITH RECURSIVE t(bucket, item, level) USING KEY (bucket, item) AS (
	SELECT bucket, item, CASE WHEN bucket = 0 THEN 0 ELSE 100 END
	FROM range(current_setting('standard_vector_size')::BIGINT * 4) b(bucket), range(8) i(item)
	UNION ALL
	SELECT n.bucket + 1, r.item, n.level + 1
	FROM t n
	JOIN recurring.t r ON r.bucket = n.bucket
	WHERE n.item = 0 AND n.level < 4
)
SELECT count(*) = current_setting('standard_vector_size')::BIGINT * 4 * 8,
       (SELECT level FROM t WHERE bucket = 4 AND item = 0)
FROM t;
