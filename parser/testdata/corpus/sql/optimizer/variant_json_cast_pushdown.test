CREATE TABLE strings AS
SELECT id, {'k': s, 'nested': {'k': s}}::VARIANT AS v
FROM (VALUES
    (1, 'true'),
    (2, 'x'),
    (3, '1'),
    (4, 'false'),
    (5, 'null'),
    (6, '[]'),
    (7, '{"n":1}'),
    (8, E'quote"\\line\n'),
    (9, ''),
    (10, NULL)
) t(id, s);
