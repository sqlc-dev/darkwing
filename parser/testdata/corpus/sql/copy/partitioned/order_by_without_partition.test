SET partitioned_write_flush_threshold=2048;
--
ok
==
CREATE TABLE ordered_only_source AS
SELECT
	i::INTEGER AS id,
	CASE WHEN i % 97 = 0 THEN NULL ELSE ((i * 15485863) % 32768)::INTEGER END AS v
FROM range(16384) tbl(i);
--
ok
==
COPY ordered_only_source
TO '{TEST_DIR}/ordered_only_asc'
(FORMAT PARQUET, ORDER_BY (v ASC NULLS LAST), ROW_GROUP_SIZE 2048);
--
ok
==
SELECT count(*) > 1
FROM glob('{TEST_DIR}/ordered_only_asc/*.parquet');
--
ok
==
SELECT count(*)
FROM read_parquet('{TEST_DIR}/ordered_only_asc/*.parquet');
--
ok
==
WITH per_file AS (
	SELECT
		file_row_number,
		v,
		lag(v) OVER (PARTITION BY filename ORDER BY file_row_number) AS prev_v
	FROM read_parquet(
		'{TEST_DIR}/ordered_only_asc/*.parquet',
		filename = true,
		file_row_number = true
	)
)
SELECT count(*)
FROM per_file
WHERE file_row_number > 0
	AND ((prev_v IS NULL AND v IS NOT NULL) OR (prev_v IS NOT NULL AND v IS NOT NULL AND prev_v > v));
--
ok
==
SET partitioned_write_flush_threshold=1000000;
--
ok
==
WITH stats AS (
	COPY ordered_only_source
	TO '{TEST_DIR}/ordered_only_desc'
	(FORMAT PARQUET, ORDER_BY (v DESC NULLS FIRST), ROW_GROUP_SIZE 2048, ROW_GROUPS_PER_FILE 1,
	 FILENAME_PATTERN 'sorted_{i}', RETURN_STATS)
)
SELECT count(*) > 1, bool_and(partition_keys IS NULL)
FROM stats;
--
ok
==
SELECT count(*) = count(DISTINCT file)
FROM glob('{TEST_DIR}/ordered_only_desc/sorted_*.parquet');
--
ok
==
WITH per_file AS (
	SELECT
		file_row_number,
		v,
		lag(v) OVER (PARTITION BY filename ORDER BY file_row_number) AS prev_v
	FROM read_parquet(
		'{TEST_DIR}/ordered_only_desc/sorted_*.parquet',
		filename = true,
		file_row_number = true
	)
)
SELECT count(*)
FROM per_file
WHERE file_row_number > 0
	AND ((prev_v IS NOT NULL AND v IS NULL) OR (prev_v IS NOT NULL AND v IS NOT NULL AND prev_v < v));
