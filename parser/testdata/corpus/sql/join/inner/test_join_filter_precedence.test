CREATE TABLE single_build AS
SELECT 1000000000042::BIGINT AS k, i::INTEGER AS g
FROM range(10) t(i);
--
ok
==
EXPLAIN ANALYZE
SELECT count(*)
FROM single_probe p
JOIN single_build b
  ON p.k = b.k
 AND p.g >= b.g;
