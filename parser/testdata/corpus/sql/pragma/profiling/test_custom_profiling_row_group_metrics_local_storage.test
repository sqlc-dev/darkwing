CREATE VIEW operator_metrics AS
SELECT t.type AS operator_type,
       t.row_groups_scanned AS scanned,
       t.total_row_groups_to_scan AS total
FROM '{TEST_DIR}/profiling_output.json' prof,
     LATERAL unnest(prof.operator) t0(op0),
     LATERAL unnest(op0.children) t1(op1),
     LATERAL unnest(op1.children) t2(op2),
     LATERAL unnest(op2.children) t3(t)
WHERE t.type = 'TABLE_SCAN';
--
ok
==
SELECT * FROM operator_metrics WHERE operator_type = 'TABLE_SCAN' ORDER BY total;
--
ok
==
SELECT sum(scanned)::VARCHAR || '/' || sum(total)::VARCHAR
FROM operator_metrics
WHERE operator_type = 'TABLE_SCAN';
--
ok
==
