WITH data AS (
    SELECT i,
           (CASE WHEN i = 37 THEN 1000 ELSE i % 7 END)::DOUBLE AS y,
           make_timestamp_ns(1577836800000000000 + i) AS ts
    FROM range(100) t(i)
),
num AS (
    SELECT UNNEST(lttb(i::DOUBLE, y, 10 ORDER BY i)) AS p
    FROM data
),
ns AS (
    SELECT UNNEST(lttb(ts, y, 10 ORDER BY ts)) AS p
    FROM data
)
SELECT (SELECT list(p.x ORDER BY p.x) FROM num)
       = (SELECT list((epoch_ns(p.x) - 1577836800000000000)::DOUBLE ORDER BY epoch_ns(p.x)) FROM ns)
--
ok
==
