CREATE TABLE vertices AS SELECT i::INTEGER AS id FROM range(1, 101) t(i);
--
ok
==
SELECT count(*) FROM (
SELECT t.id, r.depth
FROM vertices t,
LATERAL (
    WITH RECURSIVE walk(depth) AS (
        SELECT 0 + t.id * 0
        UNION ALL
        SELECT depth + 1 FROM walk WHERE depth < 7
    )
    SELECT depth FROM walk
) r
) q WHERE id = 3;
--
ok
==
EXPLAIN SELECT count(*) FROM (
SELECT t.id, r.depth
FROM vertices t,
LATERAL (
    WITH RECURSIVE walk(depth) AS (
        SELECT 0 + t.id * 0
        UNION ALL
        SELECT depth + 1 FROM walk WHERE depth < 7
    )
    SELECT depth FROM walk
) r
) q WHERE id = 3;
