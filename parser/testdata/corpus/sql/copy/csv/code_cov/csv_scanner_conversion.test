COPY (
	SELECT
		4294967295::UINTEGER AS ui,
		340282366920938463463374607431768211455::UHUGEINT AS uhi,
		340282366920938463463374607431768211456::BIGNUM AS bn,
		12.34::DECIMAL(4, 2) AS d16,
		1234567.89::DECIMAL(9, 2) AS d32,
		1234567890123456.78::DECIMAL(18, 2) AS d64,
		123456789012345678901234567890123456.78::DECIMAL(38, 2) AS d128
) TO '{TEST_DIR}/scanner_numbers.csv' (FORMAT CSV, HEADER false)
--
ok
==
SELECT *
FROM read_csv(
	'{TEST_DIR}/scanner_numbers.csv',
	auto_detect = false,
	header = false,
	columns = {
		'ui': 'UINTEGER',
		'uhi': 'UHUGEINT',
		'bn': 'BIGNUM',
		'd16': 'DECIMAL(4, 2)',
		'd32': 'DECIMAL(9, 2)',
		'd64': 'DECIMAL(18, 2)',
		'd128': 'DECIMAL(38, 2)'
	}
)
--
ok
==
COPY (
	SELECT *
	FROM (VALUES ('12,34', '1234567,89', '1234567890123456,78', '123456789012345678901234567890123456,78'))
		t(d16, d32, d64, d128)
) TO '{TEST_DIR}/scanner_comma_decimals.csv' (FORMAT CSV, HEADER false, DELIMITER ';', QUOTE '')
--
ok
==
SELECT *
FROM read_csv(
	'{TEST_DIR}/scanner_comma_decimals.csv',
	auto_detect = false,
	header = false,
	delim = ';',
	decimal_separator = ',',
	columns = {
		'd16': 'DECIMAL(4, 2)',
		'd32': 'DECIMAL(9, 2)',
		'd64': 'DECIMAL(18, 2)',
		'd128': 'DECIMAL(38, 2)'
	}
)
--
ok
