WITH actual AS (
    SELECT id, __mark_join_marker AS marker
    FROM list_probes p JOIN BY(TYPE MARK) list_build b ON p.k {comparison} b.k
), expected AS (
    SELECT id, CASE WHEN bool_or(p.k {comparison} b.k) THEN true
                    WHEN count(*) FILTER (WHERE (p.k {comparison} b.k) IS NULL) > 0 THEN NULL
                    ELSE false END AS marker
    FROM list_probes p CROSS JOIN list_build b GROUP BY id
)
SELECT count(*) FROM actual JOIN expected USING (id)
WHERE actual.marker IS DISTINCT FROM expected.marker;
