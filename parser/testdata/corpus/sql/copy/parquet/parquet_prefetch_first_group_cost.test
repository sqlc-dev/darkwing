COPY (
    SELECT CASE WHEN i%2000=0 THEN 0 ELSE 1 END AS flag,
        md5(i::VARCHAR)||md5((i+1)::VARCHAR)||md5((i+2)::VARCHAR)||md5((i+3)::VARCHAR) AS payload
    FROM range(4096) t(i)
) TO '{TEST_DIR}/cheap_first_filter.parquet'
    (ROW_GROUP_SIZE 2048, COMPRESSION 'uncompressed', WRITE_BLOOM_FILTER FALSE)
--
ok
==
COPY (
    SELECT md5(i::VARCHAR) AS f, md5((i+1)::VARCHAR) AS payload
    FROM range(4096) t(i)
) TO '{TEST_DIR}/expensive_first_filter.parquet'
    (ROW_GROUP_SIZE 2048, COMPRESSION 'uncompressed', WRITE_BLOOM_FILTER FALSE)
--
ok
==
SELECT bit_xor(hash(flag,payload)) FROM read_parquet('{TEST_DIR}/cheap_first_filter.parquet') WHERE flag=1
--
ok
==
SELECT row_group_id,strategy FROM duckdb_logs_parsed('ParquetPrefetch')
WHERE file_path LIKE '%cheap_first_filter.parquet' ORDER BY row_group_id
--
ok
