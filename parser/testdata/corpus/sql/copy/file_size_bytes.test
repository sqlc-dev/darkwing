COPY (SELECT col_a % 4 AS p, col_a, col_b FROM bigdata)
TO '{TEST_DIR}/file_size_bytes_csv_partitioned'
(FORMAT CSV, FILE_SIZE_BYTES '50kb', PARTITION_BY (p));
