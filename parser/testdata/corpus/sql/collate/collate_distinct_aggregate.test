PREPARE distinct_rows AS
SELECT len(list(DISTINCT row(s COLLATE NOCASE))), len(list(DISTINCT row(s)))
FROM (VALUES ($1::VARCHAR), ($2::VARCHAR)) t(s);
--
ok
==
EXECUTE distinct_rows('a', 'A');
--
ok
==
EXECUTE distinct_rows('a', 'b');
