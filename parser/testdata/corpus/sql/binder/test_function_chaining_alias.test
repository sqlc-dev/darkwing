PREPARE v1 AS 
SELECT
	(?.split(' ')::VARCHAR).lower() lstrings,
	(?.split(' ')::VARCHAR).upper() ustrings,
	list_concat(lstrings::VARCHAR[], ustrings::VARCHAR[]) AS mix_case_srings
--
ok
