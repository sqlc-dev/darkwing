SELECT total_profit,
		name,
		COUNT(total_profit) OVER(PARTITION BY total_profit) AS CountTotalProfit,
		SUM(amount_sold) OVER(PARTITION BY total_profit) AS SumAmountSold,
		SUM(price) OVER(PARTITION BY total_profit) AS SumPrice
FROM unit
ORDER BY 1, 2 DESC
