WITH t(a,b) AS (
  VALUES 
    (0, 'a'), (0, 'b'),
    (1, 'c'),
    (2, 'd'), (2, 'e'), (2, 'f')
), framed AS (
	SELECT a, b,
		   nth_value(b, 1)            OVER w AS b1,
		   nth_value(b, 1 ORDER BY b) OVER w AS b1_ordered,
	FROM t
	WINDOW w AS (ORDER BY a RANGE BETWEEN CURRENT ROW AND CURRENT ROW)
)
FROM framed
where a = 1
--
ok
==
WITH t(a, q) AS (
  VALUES
    (1, NULL),
    (2, 0)
)
SELECT
  a,
  q,
  FIRST_VALUE(q ORDER BY 1 IGNORE NULLS) OVER (
    PARTITION BY q, a
  ) AS actual
FROM t
ORDER BY a;
--
ok
