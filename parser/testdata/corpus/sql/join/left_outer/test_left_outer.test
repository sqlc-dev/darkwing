SELECT pl.id, g.k, t.player_id, mo.player_id
FROM (SELECT 1 AS id) pl
CROSS JOIN (SELECT 1 AS k) g
LEFT JOIN (SELECT 1 AS player_id) t ON pl.id = t.player_id
LEFT JOIN (SELECT 1 AS player_id) mo ON pl.id = mo.player_id;
--
ok
