SELECT
	v.split(' ') strings,
	strings.apply(lambda x: x.lower()).filter(lambda x: x[1] == 't' OR x[1] == 'a') lower,
	strings.apply(lambda x: x.upper()).filter(lambda x: x[1] == 'T' OR x[1] == 'A') upper,
	lower + upper AS mix_case_srings
FROM varchars
WHERE mix_case_srings[1] = 'test'
