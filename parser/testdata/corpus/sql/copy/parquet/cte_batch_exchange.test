EXPLAIN ANALYZE
COPY (
	WITH first AS MATERIALIZED (
		SELECT i FROM cte_parquet_source WHERE i < 500000
		UNION ALL
		SELECT i FROM cte_parquet_source WHERE i >= 500000
	), second AS MATERIALIZED (
		SELECT i FROM first
	)
	SELECT i FROM second
) TO '{TEST_DIR}/cte_nested_batch_exchange.parquet' (FORMAT parquet);
