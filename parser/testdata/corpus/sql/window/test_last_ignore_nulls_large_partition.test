SELECT count(x), count(*) FILTER (x IS DISTINCT FROM m) FROM (
    SELECT last(CASE WHEN i != 3 THEN i END ORDER BY i IGNORE NULLS)
           OVER (ORDER BY i ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) x,
           max(CASE WHEN i != 3 THEN i END)
           OVER (ORDER BY i ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) m
    FROM range(1, 33000) t(i));
--
ok
==
SELECT count(x), count(*) FILTER (x IS DISTINCT FROM m) FROM (
    SELECT last(CASE WHEN i % 1000 != 3 THEN i END ORDER BY i DESC IGNORE NULLS)
           OVER (PARTITION BY i % 2 ORDER BY i ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) x,
           min(CASE WHEN i % 1000 != 3 THEN i END)
           OVER (PARTITION BY i % 2 ORDER BY i ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) m
    FROM range(1, 100000) t(i));
--
ok
==
SELECT count(x), count(*) FILTER (x IS DISTINCT FROM m) FROM (
    SELECT last(CASE WHEN i % 7 = 0 AND i > 500 THEN i END ORDER BY i IGNORE NULLS)
           OVER (ORDER BY i ROWS BETWEEN 2000 PRECEDING AND CURRENT ROW) x,
           max(CASE WHEN i % 7 = 0 AND i > 500 THEN i END)
           OVER (ORDER BY i ROWS BETWEEN 2000 PRECEDING AND CURRENT ROW) m
    FROM range(1, 200000) t(i));
--
ok
