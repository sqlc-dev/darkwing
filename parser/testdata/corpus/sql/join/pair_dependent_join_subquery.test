ok
==
SELECT l.a, r.b
FROM pair_state_l l
LEFT JOIN pair_state_r r ON EXISTS (
	WITH RECURSIVE walk(n) AS (
		SELECT l.a
		UNION ALL
		SELECT n + 1 FROM walk WHERE n < r.b
	)
	SELECT 1 FROM walk WHERE n = r.b
)
ORDER BY ALL;
--
ok
==
SELECT l.a, r.b
FROM pair_state_l l
LEFT JOIN pair_state_r r ON EXISTS (
	(SELECT 1 WHERE l.a = r.b)
	UNION ALL
	(SELECT 1 WHERE l.a + 1 = r.b)
)
ORDER BY ALL;
--
ok
==
SELECT l.a, r.b
FROM pair_state_l l
LEFT JOIN pair_state_r r ON EXISTS (
	(SELECT l.a)
	INTERSECT
	(SELECT r.b)
)
ORDER BY ALL;
--
ok
