SELECT o, wh, EXISTS(
	SELECT 1
	FROM exists_sales s2
	WHERE s1.o=s2.o
		AND s1.wh<>s2.wh
) AS ex
FROM exists_sales s1
WHERE ship_date=1
ORDER BY o;
