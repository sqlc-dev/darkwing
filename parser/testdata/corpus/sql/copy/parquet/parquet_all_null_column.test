COPY (SELECT i, CASE WHEN i % 2 = 0 THEN {'a': NULL::INTEGER} ELSE NULL END AS s FROM range(10) t(i)) TO '{TEST_DIR}/nested_null.parquet' (FORMAT PARQUET);
