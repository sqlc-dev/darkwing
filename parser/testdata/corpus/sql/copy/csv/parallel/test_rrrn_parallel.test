    SELECT id, COUNT(*) AS cnt
    FROM read_csv('{TEST_DIR}/rrrn_test.csv',
        auto_detect=false, header=true, delim=',',
        columns={'id':'BIGINT','val':'VARCHAR'},
        strict_mode=false, ignore_errors=true,
        buffer_size=1024, parallel=true)
