CREATE TABLE events AS
SELECT i,
       CASE WHEN i = 50000 THEN NULL
            ELSE {'meta': {'ts': CASE WHEN i = 50001 THEN NULL
                                      WHEN i = 99999 THEN TIMESTAMP '2100-01-01'
                                      ELSE TIMESTAMP '2020-01-01' + i * INTERVAL 1 SECOND
                                 END}}
       END AS payload
FROM range(100000) t(i)
--
ok
