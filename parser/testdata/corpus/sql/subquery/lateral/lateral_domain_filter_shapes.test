CREATE VIEW shape_exists AS
SELECT input.id,w.depth FROM vertices input
CROSS JOIN LATERAL (
    WITH RECURSIVE walk(depth) AS (
        SELECT 0+input.id*0
        UNION ALL
        SELECT depth+1 FROM walk WHERE depth<7 AND EXISTS (SELECT 1 FROM vertices v WHERE v.id=walk.depth)
    )
    SELECT depth FROM walk
) w
JOIN vertices target ON target.id=w.depth+1;
--
ok
==
