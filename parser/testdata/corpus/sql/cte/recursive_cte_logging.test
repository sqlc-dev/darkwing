WITH RECURSIVE t(i, digest, level) AS (
	SELECT i, md5(i::VARCHAR), 0
	FROM range(current_setting('standard_vector_size')::BIGINT * 2) values(i)
	UNION ALL
	(
		WITH state AS MATERIALIZED (
			SELECT i, md5(md5(md5(digest))) AS digest, level + 1 AS level
			FROM t
			WHERE level < 3
		)
		SELECT * FROM state WHERE i % 6 = 0
		UNION ALL
		SELECT * FROM state WHERE i % 6 = 1
		UNION ALL
		SELECT * FROM state WHERE i % 6 = 2
		UNION ALL
		SELECT * FROM state WHERE i % 6 = 3
		UNION ALL
		SELECT * FROM state WHERE i % 6 = 4
		UNION ALL
		SELECT * FROM state WHERE i % 6 = 5
	)
)
SELECT count(*) = current_setting('standard_vector_size')::BIGINT * 8,
       max(level),
       sum(length(digest)) = current_setting('standard_vector_size')::BIGINT * 8 * 32
FROM t;
--
ok
==
WITH RECURSIVE t(i, level, rn) AS (
	SELECT i, 0, 0::BIGINT
	FROM range(current_setting('standard_vector_size')::BIGINT * 2) values(i)
	UNION ALL
	(
		WITH tmp AS MATERIALIZED (SELECT * FROM t),
		ranked AS (
			SELECT a.i,
			       a.level,
			       row_number() OVER (PARTITION BY a.i ORDER BY b.i DESC) AS rn
			FROM tmp a
			JOIN tmp b
			  ON a.i % greatest(current_setting('standard_vector_size')::BIGINT / 64, 1)
			   = b.i % greatest(current_setting('standard_vector_size')::BIGINT / 64, 1)
		)
		SELECT i, level + 1, rn
		FROM ranked
		WHERE rn = 1 AND level < 2
	)
)
SELECT count(*) = current_setting('standard_vector_size')::BIGINT * 6,
       max(level) = 2,
       sum(rn) = current_setting('standard_vector_size')::BIGINT * 4
FROM t;
--
ok
==
