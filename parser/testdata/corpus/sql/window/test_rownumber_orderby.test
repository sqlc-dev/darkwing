SELECT 
	i,
	(i * 29) % 11 AS outside,
	row_number(ORDER BY (i // 2) DESC) OVER w,
	ntile(4 ORDER BY (i // 2) DESC) OVER w,
FROM range(10) tbl(i)
WINDOW w AS (
	ORDER BY (i * 29) % 11
)
ORDER BY 2
--
ok
