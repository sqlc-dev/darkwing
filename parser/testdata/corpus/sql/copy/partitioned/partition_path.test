PARTITION_PATH CASE WHEN region = 'eu' AND other_col = 'us-east-1' THEN 'val1/val2'
ELSE 'region=' || region || '/other_col=' || coalesce(other_col, '__HIVE_DEFAULT_PARTITION__') END);
