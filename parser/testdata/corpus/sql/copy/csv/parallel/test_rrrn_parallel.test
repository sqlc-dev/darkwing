COPY (
    SELECT (repeat('p', 23) || chr(13) || chr(13) || chr(10) ||
        string_agg(lpad(CAST(t.id AS VARCHAR), 2, '0') || ',' ||
                   repeat('x', 19) || chr(13) || chr(13) || chr(10), '')
    )::BLOB
    FROM generate_series(0, 59) t(id)
) TO '{TEST_DIR}/rrrn_test.csv' (FORMAT BLOB);
