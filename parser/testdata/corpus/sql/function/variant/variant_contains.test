CREATE MACRO variant_contains_self(value) AS variant_contains(value::VARIANT, value::VARIANT);
--
ok
==
SELECT list_bool_and(results) AND list_count(results) = length(results)
FROM (
	SELECT [*COLUMNS(*)] AS results
	FROM (
		SELECT variant_contains_self(
			COLUMNS(lambda c: NOT regexp_matches(c, 'array|struct|map|union|tuple'))
		)
		FROM test_all_types()
		WHERE bool IS NOT NULL
	)
);
--
ok
==
