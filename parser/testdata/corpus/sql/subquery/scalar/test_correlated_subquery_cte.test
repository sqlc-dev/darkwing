SELECT *
FROM generate_series(1,2) AS t1(a),
LATERAL (
    SELECT *
    FROM generate_series(1,2) AS t2(b),
    LATERAL (
        WITH cte AS (SELECT a + b AS x)
        SELECT (FROM (FROM cte) WHERE x = a + b)
    )
)
ORDER BY a, b;
--
ok
