    ('{"duck": null}'),
    ('{"duck": nulL}'),
    ('{"duck": nuLl}'),
    ('{"duck": nuLL}'),
    ('{"duck": nUll}'),
    ('{"duck": nUlL}'),
    ('{"duck": nULl}'),
    ('{"duck": nULL}'),
