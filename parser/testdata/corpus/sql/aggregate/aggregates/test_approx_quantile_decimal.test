CREATE OR REPLACE TEMP TABLE extremes AS
SELECT d, approx_quantile(d, 0.5) q, approx_quantile(d, [0, 0.5, 1]) qs,
       approx_quantile(d, 0.5) EXPORT_STATE s, approx_quantile(d, [0, 0.5, 1]) EXPORT_STATE ss
FROM (
    SELECT ('{sign}' || repeat('9', {width} - {scale}) ||
            CASE WHEN {scale} = 0 THEN '' ELSE '.' || repeat('9', {scale}) END)::DECIMAL({width},{scale}) d
) t
GROUP BY d;
