CREATE TABLE zz AS
    SELECT
           CAST(i AS SMALLINT) AS id,
           CAST(i AS SMALLINT) AS si
    FROM generate_series(1, 1000) t(i);
--
ok
==
SELECT ROUND(53) AS ag_column3
FROM zz
GROUP BY ag_column3
ORDER BY ag_column3
--
ok
==
SELECT ROUND(53, si) AS ag_column3
FROM zz
GROUP BY ag_column3
ORDER BY ag_column3
--
ok
==
SELECT ROUND(53, -si) AS ag_column3
FROM zz
GROUP BY ag_column3
ORDER BY ag_column3
