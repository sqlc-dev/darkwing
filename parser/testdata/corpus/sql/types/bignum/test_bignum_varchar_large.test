CREATE TABLE strings AS
SELECT n, CASE WHEN n % 3 = 0 THEN '-' ELSE '' END || (1 + n % 9)::VARCHAR ||
       array_to_string(list_transform(range(n), lambda j: ((j * 7 + n) % 10)::VARCHAR), '') AS s
FROM range(0, 20000, 97) t(n);
--
ok
==
SELECT count(*) FROM strings WHERE s::BIGNUM::VARCHAR <> s;
--
ok
==
SELECT (repeat('9', 20000)::BIGNUM + 1::BIGNUM)::VARCHAR = '1' || repeat('0', 20000);
--
ok
==
SELECT (('1' || repeat('0', 30000))::BIGNUM - 1::BIGNUM)::VARCHAR = repeat('9', 30000);
--
ok
==
SELECT (('-1' || repeat('0', 12345) || '1')::BIGNUM)::VARCHAR = '-1' || repeat('0', 12345) || '1';
--
ok
==
SELECT length(('3' || repeat('1', 40000))::BIGNUM::VARCHAR);
