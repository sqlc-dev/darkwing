CREATE MACRO join_args(x, y := 'default') AS coalesce(x, 'null') || ':' || y;
--
ok
==
SELECT join_args(#1, #2) FROM (VALUES ('left', 'right')) AS t(y, x);
--
ok
==
SELECT join_args(#1, #2) FROM (VALUES (NULL::VARCHAR, 'right')) AS t(y, x);
--
ok
==
SELECT join_args(#1) FROM (VALUES ('left')) AS t(y);
