with grouped as (
    select variant_group_object(k, v) as obj
    from (values
        ('', 'empty'::VARIANT),
        ('A', 'upper'::VARIANT),
        ('a', 'lower'::VARIANT),
        ('ключ', 'unicode'::VARIANT),
        (repeat('k', 32), 'long'::VARIANT),
        (repeat('k', 31) || 'x', 'long_prefix'::VARIANT)
    ) t(k, v)
)
select contains(variant_extract_string(obj, ''), '"":"empty"')
   and variant_extract_string(obj, 'A') = 'upper'
   and variant_extract_string(obj, 'a') = 'lower'
   and variant_extract_string(obj, 'ключ') = 'unicode'
   and variant_extract_string(obj, repeat('k', 32)) = 'long'
   and variant_extract_string(obj, repeat('k', 31) || 'x') = 'long_prefix'
from grouped;
--
ok
==
