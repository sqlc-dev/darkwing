	SELECT
		((i % 100) * 2)::INTEGER AS r,
		i::BIGINT AS payload
	FROM range(20480) t(i)
) TO '{TEST_DIR}/bloom_in.parquet' (
	FORMAT PARQUET,
	ROW_GROUP_SIZE 2048,
	WRITE_BLOOM_FILTER TRUE
);
