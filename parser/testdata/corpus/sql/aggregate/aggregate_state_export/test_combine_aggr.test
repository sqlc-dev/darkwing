WITH states AS (
    SELECT g, sum(v) EXPORT_STATE AS s, count(*)::INTEGER AS n
    FROM (VALUES (0, 1), (0, 2), (1, 10), (2, 5), (2, 7), (2, 8), (3, 20)) t(g, v)
    GROUP BY g
)
SELECT g % 2 AS bucket, finalize(combine_aggr(s, n))
FROM states
GROUP BY bucket
ORDER BY bucket;
