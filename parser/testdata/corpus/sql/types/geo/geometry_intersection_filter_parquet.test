COPY (
	select
		(x + y * 1000) as id,
		printf('POINT(%d %d)', x, y)::GEOMETRY as g
	from range(1000) xx(x), range(10) yy(y)
) TO '{TEST_DIR}/points.parquet' (FORMAT 'parquet', GEOPARQUET_VERSION 'NONE', ROW_GROUP_SIZE 1000);
