CREATE VIEW nested_updates AS
SELECT o.id, o.selected, q.x
FROM person o, LATERAL (
    SELECT r.x FROM person i, LATERAL (
        WITH RECURSIVE walk(k, v) USING KEY(k) AS (
            SELECT 0, i.id * 0
            UNION
            SELECT k, v+1 FROM walk WHERE v < i.id % 3 + 1
        ) SELECT max(v) x FROM walk
    ) r WHERE i.id=o.id
    UNION ALL SELECT -1
) q;
--
ok
==
SELECT count(*), sum(x), max(x) FROM nested_updates WHERE selected;
--
ok
==
CREATE VIEW deeply_nested AS
SELECT o.id, o.selected, q.x
FROM person o, LATERAL (
    SELECT middle_result.x
    FROM person m, LATERAL (
        SELECT r.x FROM person i, LATERAL (
            WITH RECURSIVE walk(x) USING KEY(x) AS (
                SELECT i.id
                UNION
                SELECT x+1 FROM walk WHERE x<i.id+2
            ) SELECT max(x) x FROM walk
        ) r WHERE i.id=m.id
        UNION ALL SELECT -1
    ) middle_result WHERE m.id=o.id
    UNION ALL SELECT -1
) q;
--
ok
==
SELECT count(*),sum(x),max(x) FROM deeply_nested WHERE selected;
--
ok
