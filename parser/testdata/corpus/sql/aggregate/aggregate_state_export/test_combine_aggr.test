WITH states AS (
    SELECT
        k,
        list(v) EXPORT_STATE AS list_s,
        median(v) EXPORT_STATE AS median_s,
        quantile_cont(v, 0.5) EXPORT_STATE AS quantile_s,
        mad(v) EXPORT_STATE AS mad_s
    FROM (VALUES (1, 1), (1, 1), (2, 42), (2, 42)) t(k, v)
    GROUP BY k
)
