	FROM glob('{TEST_DIR}/partition_path_hive_default/**/*.parquet')
) d
FULL OUTER JOIN (
	SELECT regexp_extract(replace(file, '\', '/'), 'partition_path_hive_expression/(.*)$', 1) AS expression_file
