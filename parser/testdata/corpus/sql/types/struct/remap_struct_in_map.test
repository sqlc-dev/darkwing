SELECT typeof(mapped) = typeof(NULL::MAP(VARCHAR, STRUCT(a INTEGER))), mapped
FROM (SELECT remap_struct(
    MAP {'one': NULL::"NULL", 'two': NULL::"NULL"},
    NULL::MAP(VARCHAR, STRUCT(a INTEGER)),
    {'key': 'key', 'value': 'value'},
    NULL
) AS mapped);
--
ok
