CREATE TABLE strings AS
SELECT CASE range // 2048
    WHEN 0 THEN 'v000000'
    WHEN 1 THEN 'v000001'
    WHEN 2 THEN 'v000010'
    ELSE 'v999999'
END AS s, 1 AS payload
FROM range(8192);
--
ok
==
SELECT sum(payload) FROM strings WHERE s NOT IN ('v000000', 'v000010');
--
ok
==
SELECT sum(payload) FROM strings WHERE s <> 'v000000' AND s <> 'v000010';
