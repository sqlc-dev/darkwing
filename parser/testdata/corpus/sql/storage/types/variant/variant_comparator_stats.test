	s.min::VARCHAR = variant_comparator(1::INTEGER::VARIANT)::VARCHAR,
	s.max::VARCHAR = variant_comparator(100::INTEGER::VARIANT)::VARCHAR
FROM (SELECT stats(variant_comparator(col)) s FROM ints LIMIT 1);
