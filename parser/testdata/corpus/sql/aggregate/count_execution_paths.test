CREATE TABLE count_validity AS
SELECT i,
       CASE
           WHEN i < 64 THEN i
           WHEN i < 128 THEN NULL
           WHEN i % 2 = 0 THEN i
           ELSE NULL
       END AS v
FROM range(192) t(i);
--
ok
==
SELECT count(v) FROM count_validity;
