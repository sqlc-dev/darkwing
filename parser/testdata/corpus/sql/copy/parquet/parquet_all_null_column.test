COPY (SELECT range AS i, NULL::BIGINT AS n FROM range(10000)) TO '{TEST_DIR}/all_null.parquet' (FORMAT PARQUET, ROW_GROUP_SIZE 2048);
--
ok
==
SELECT count(n) FROM '{TEST_DIR}/all_null.parquet';
--
ok
==
