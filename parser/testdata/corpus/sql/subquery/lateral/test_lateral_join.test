SELECT *
FROM generate_series(1,3) AS input(n),
LATERAL (
    WITH RECURSIVE subquery(x) AS (
        (SELECT n, true AS exists)
        UNION ALL
        SELECT x - 1, y
        FROM subquery AS _(x),
        LATERAL (
            SELECT NOT EXISTS (
                SELECT 1
                FROM subquery AS input(a)
                WHERE a > _.x
            )
        ) AS __(y)
        WHERE x > 0
    )
    TABLE subquery
)
ORDER BY n, x;
--
ok
