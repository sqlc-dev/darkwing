CREATE OR REPLACE VIEW repeated_lists AS
SELECT ['a', 'b'] AS strings,
       ['abcdefghijklmnop', NULL, ''] AS nullable_strings,
       [['a', 'b'], [], NULL, ['c', NULL]] AS nested_strings,
       [{'s': 'abcdefghijklmnop', 'l': ['a', 'b']}, NULL] AS structs,
       MAP(['a', 'b'], ['c', 'd']) AS maps,
       ['a'::BLOB, '\x00\xFF'::BLOB] AS blobs,
       []::VARCHAR[] AS empty_list,
       NULL::VARCHAR[] AS null_list,
       CASE WHEN range % 7 = 0 THEN NULL
            WHEN range % 7 = 1 THEN ''
            ELSE repeat('x', 1 + range % 101) END AS scalar_strings,
       '' AS empty_string,
       NULL::VARCHAR AS null_string
FROM range({row_count});
--
