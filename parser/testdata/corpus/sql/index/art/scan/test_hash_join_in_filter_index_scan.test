	(SELECT o_orderkey FROM orders
	OFFSET 100
	LIMIT 3)
	UNION
	(SELECT o_orderkey FROM orders
	OFFSET (SELECT COUNT(*) FROM orders) / 2
	LIMIT 3)
	UNION
	(SELECT o_orderkey FROM orders
	OFFSET (SELECT COUNT(*) FROM orders) / 2 + 100000
	LIMIT 3));
