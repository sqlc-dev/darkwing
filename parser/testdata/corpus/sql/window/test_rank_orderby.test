SELECT
	id,
	k,
	rank(ORDER BY k) OVER w,
	percent_rank(ORDER BY k) OVER w,
FROM (VALUES (1, 1), (2, 1), (3, 2)) tbl(id, k)
WINDOW w AS (
	ORDER BY k, id
)
ORDER BY id
