SELECT
    sum(aggr1)::DOUBLE / count(aggr1)::DOUBLE AS avg_qty,
    sum(aggr2)::DOUBLE / count(aggr2)::DOUBLE AS avg_price,
    sum(aggr3)::DOUBLE / count(aggr3)::DOUBLE AS avg_disc
FROM
    groups
GROUP BY
    grp
ORDER BY grp;
