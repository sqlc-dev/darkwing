SELECT remap_struct(
	MAP {
		'my_key1' : {
			'i': 10,
			'j': {
				'x': 42,
				'z': 100
			}
		},
		'my_key2' : {
			'i': 20,
			'j': {
				'x': 21,
				'z': 50
			}
		}
	}, -- data
	NULL::MAP(VARCHAR, STRUCT(
		v1 INT,
		v2 STRUCT(
			x INT,
			y INT,
			z INT
		),
		v3 VARCHAR
	)), -- target type
	{
		'key': 'key',
		'value': ROW(
			'value', {
				'v1': 'i',
				'v2': ROW(
					'j', {
						'x': 'x',
						'z': 'z'
					}
				)
			}
		)
	}, -- remapping data -> target_type
	{
		'value': {
			'v2': {
				'y': NULL::INT
			},
			'v3': NULL::VARCHAR
		}
	}
); -- defaults
--
ok
==
