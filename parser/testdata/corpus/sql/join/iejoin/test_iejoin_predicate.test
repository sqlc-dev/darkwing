create or replace table tleft as
	select 
		i as k100,
		'2024-01-01'::TIMESTAMP + INTERVAL (i) seconds as b100,
		b100 + INTERVAL 1 second as e100,
	from range(10) as tbl(i);
--
ok
==
select l.k100 as lid, r.k100 as rid
from tleft l 
inner join tleft r 
on l.b100 < r.e100
and r.b100 < l.e100
and l.k100 + r.k100 < 10
order by 1
--
ok
==
