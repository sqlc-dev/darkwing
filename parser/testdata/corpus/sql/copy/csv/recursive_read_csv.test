create table r AS SELECT * FROM read_csv('{DATA_DIR}/csv/test/date.csv', columns=STRUCT_PACK(d := 'DATE'), header=0, auto_detect=0);
--
ok
==
WITH RECURSIVE t(i) AS
(
	SELECT 1, NULL::DATE
	UNION ALL
	(
		SELECT i+1, d
		FROM t, r
		WHERE i<5
	)
)
SELECT * FROM t ORDER BY i;
--
ok
