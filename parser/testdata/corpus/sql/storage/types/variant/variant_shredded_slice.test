insert into bluesky select
  case when i%3=0
       then {'kind':'commit','did':'c'|| (i%4),'commit':{'collection':'coll'|| (i%2),'operation':'create'}}::VARIANT
       else {'kind':'identity','did':'d'|| (i%5)}::VARIANT
  end
from range(4096) t(i)
