CREATE TABLE skewed AS SELECT i // 2048 AS p, i,
    CASE WHEN i % 2048 < 100 THEN repeat(md5(i::VARCHAR), 2048) ELSE md5(i::VARCHAR) END::BLOB AS payload
FROM range(4096) t(i)
--
ok
