CREATE TABLE isnan_tb AS SELECT
  CASE WHEN range // 2048 = 2 THEN 'NaN'::DOUBLE
       WHEN range % 2 = 0 THEN range::DOUBLE
       ELSE NULL END AS d,
  CASE WHEN range // 2048 = 2 THEN 'NaN'::FLOAT
       WHEN range % 2 = 0 THEN range::FLOAT
       ELSE NULL END AS f
FROM range(6144);
--
ok
