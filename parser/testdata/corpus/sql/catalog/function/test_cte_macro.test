CREATE MACRO deep_cte(param) AS (
    WITH cte1 AS (
        WITH cte2 AS (
            WITH cte3 AS (
                WITH cte4 AS (
                    SELECT param AS d
                )
                SELECT d AS c FROM cte4
            )
            SELECT c AS b FROM cte3
        )
        SELECT b AS a FROM cte2
    )
    SELECT a FROM cte1
)
--
ok
==
SELECT deep_cte(42)
--
ok
