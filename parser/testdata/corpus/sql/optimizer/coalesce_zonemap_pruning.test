CREATE TABLE coalesce_pruning AS
SELECT i::INTEGER AS i,
       CASE WHEN i % 100 = 0 THEN NULL ELSE i END::INTEGER AS x,
       i::INTEGER AS y
FROM range(6144) r(i);
