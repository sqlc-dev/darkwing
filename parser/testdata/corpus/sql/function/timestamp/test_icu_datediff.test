ok
==
INSERT INTO era_boundaries VALUES
	('coptic', '0283-08-29 12:00:00+00', '0284-08-29 12:00:00+00'),
	('roc', '1911-12-31 12:00:00+00', '1912-01-01 12:00:00+00'),
	('japanese', '1912-07-29 00:00:00+00', '2019-05-01 00:00:00+00');
--
ok
