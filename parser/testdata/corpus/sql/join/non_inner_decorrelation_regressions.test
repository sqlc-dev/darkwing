WITH a(k, v) AS (VALUES (1, 10), (2, 20), (3, 30)),
     p(flag) AS (VALUES (true), (false)),
     b(k, v) AS (VALUES (1, 10), (2, 99), (4, 40))
SELECT a.k, a.v, p.flag, b.k, b.v
FROM a
CROSS JOIN p
LEFT JOIN b ON b.k = a.k AND b.v = a.v AND p.flag
ORDER BY ALL;
--
ok
==
WITH a(k, v) AS (VALUES (1, 10), (2, 20), (3, 30)),
     b(k, v) AS (VALUES (1, 10), (2, 99)),
     c(k, v) AS (VALUES (1, 15), (3, 35)),
     d(k, v) AS (VALUES (3, 30), (2, 99))
SELECT a.k, a.v, b.k, b.v
FROM a
LEFT JOIN b ON b.k = a.k AND b.v >= a.v AND a.v < 25
SEMI JOIN c ON c.k = a.k AND (b.k IS NULL OR c.v > b.v)
ANTI JOIN d ON d.k = a.k AND (b.k IS NULL OR d.v = b.v)
ORDER BY ALL;
