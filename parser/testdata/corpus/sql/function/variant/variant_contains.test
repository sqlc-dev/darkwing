CREATE TABLE varying_objects AS
SELECT
	range AS id,
	CASE
		WHEN range % 2 = 0 THEN {'duck': 42}::VARIANT
		ELSE {'duck': 42, 'goose': 43}::VARIANT
	END AS haystack
FROM range(4096);
--
ok
==
SELECT id % 2, count_if(variant_contains(haystack, {'goose': 43}::VARIANT))
FROM varying_objects
GROUP BY ALL
ORDER BY ALL;
--
ok
