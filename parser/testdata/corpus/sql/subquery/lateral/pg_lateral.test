select * from
  (values (100), (300), (500)) as r(a),
  lateral (
    select (g/2)::int as c1,
           array_agg(g::int) as c2,
	   count(*) as c3
    from agg_data_1k
    where g < r.a
    group by g/2) as s
order by 1, 2, 4, 3;
