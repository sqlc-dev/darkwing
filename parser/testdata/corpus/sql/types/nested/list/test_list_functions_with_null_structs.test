WITH transformed AS (
	SELECT foo.list_transform(
                lambda x: struct_pack(val := x, conflict := false)
            ).reduce(
                lambda res, x: CASE
                    WHEN res.conflict THEN res
                    WHEN res.val = x.val THEN res
                    ELSE struct_pack(val := null, conflict := true)
					END
            ) AS result
        FROM filter_data
    )
SELECT result, result.val = '' FROM transformed;
