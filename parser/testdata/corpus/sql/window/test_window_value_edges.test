CREATE TABLE value_edges(i INTEGER, peer INTEGER, v INTEGER);
--
ok
==
INSERT INTO value_edges VALUES
    (0, 0, NULL), (1, 0, 10), (2, 0, NULL),
    (3, 1, 20), (4, 1, NULL), (5, 1, 30),
    (6, 2, NULL), (7, 2, 40), (8, 3, 50), (9, 3, NULL);
--
ok
==
SELECT first_value(peer) OVER (
           ORDER BY peer ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW EXCLUDE GROUP
       ), peer
FROM value_edges ORDER BY peer, i;
--
ok
==
SELECT last_value(peer) OVER (
           ORDER BY peer ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING EXCLUDE CURRENT ROW
       ), peer
FROM value_edges ORDER BY peer, i;
--
ok
==
SELECT nth_value(peer, 5) OVER (
           ORDER BY peer ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING EXCLUDE TIES
       ), peer
FROM value_edges ORDER BY peer, i;
--
ok
==
SELECT nth_value(v, 3 IGNORE NULLS) OVER (
           ORDER BY peer ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING EXCLUDE CURRENT ROW
       ), peer, v
FROM value_edges ORDER BY peer, v;
--
ok
==
CREATE TABLE range_edges(i INTEGER, v INTEGER);
--
ok
==
INSERT INTO range_edges VALUES (1, 10), (2, 20), (4, 40);
--
ok
==
SELECT list(s ORDER BY i) FROM (
    SELECT i, sum(v) OVER (
        ORDER BY i::{type}
        RANGE BETWEEN 1::{type} PRECEDING AND 1::{type} FOLLOWING
    ) AS s
    FROM range_edges
);
