CREATE TABLE cte_parallel_nested AS
WITH first AS MATERIALIZED (
	SELECT * FROM cte_parallel_left
	UNION ALL
	SELECT * FROM cte_parallel_right
), second AS MATERIALIZED (
	SELECT i FROM first
)
SELECT i FROM second LIMIT 750000;
--
ok
==
SELECT count(*), min(i), max(i) FROM cte_parallel_nested;
--
ok
==
SELECT count(*)
FROM cte_parallel_nested
WHERE i != rowid;
--
ok
==
CREATE TABLE cte_parallel_mixed AS
WITH t AS MATERIALIZED (
	SELECT * FROM cte_parallel_left
	UNION ALL
	SELECT * FROM cte_parallel_right
)
SELECT i, (SELECT count(*) FROM t) AS total FROM t LIMIT 250000;
--
ok
==
SELECT count(*), min(i), max(i), min(total) FROM cte_parallel_mixed;
--
ok
==
CREATE TABLE cte_parallel_sparse AS
WITH t AS MATERIALIZED (
	SELECT i FROM cte_parallel_left WHERE i % 7 != 0
	UNION ALL
	SELECT i FROM cte_parallel_right WHERE i % 11 != 0
)
SELECT i FROM t;
--
ok
==
SELECT count(*)
FROM cte_parallel_sparse current_row
JOIN cte_parallel_sparse previous_row
	ON current_row.rowid = previous_row.rowid + 1
WHERE current_row.i <= previous_row.i;
--
ok
==
CREATE TABLE cte_parallel_empty AS
WITH t AS MATERIALIZED (
	SELECT i FROM cte_parallel_left WHERE false
	UNION ALL
	SELECT i FROM cte_parallel_right WHERE false
)
SELECT i FROM t;
--
ok
==
SELECT count(*) FROM cte_parallel_empty;
--
ok
