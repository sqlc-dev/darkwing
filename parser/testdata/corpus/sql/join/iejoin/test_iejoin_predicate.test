SELECT count(*) 
FROM range(1000) r(i), 
     range(1000) d(j) 
WHERE d.j >= r.i-1 
 AND d.j <= r.i+1 
 AND d.j%3 >= r.i%3 
 AND d.j%3 <= r.i%3;
