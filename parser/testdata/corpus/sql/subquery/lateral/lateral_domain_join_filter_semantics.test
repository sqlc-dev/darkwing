WITH o AS MATERIALIZED (SELECT * FROM person WHERE selected) SELECT count(*),sum(q.x) FROM o JOIN (SELECT * FROM expanded UNION SELECT * FROM expanded) q ON o.id IS NOT DISTINCT FROM q.id AND o.tag IS NOT DISTINCT FROM q.tag;
