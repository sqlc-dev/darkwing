COPY (
    SELECT CASE WHEN i < 5 THEN 'ascii' || lpad(i::VARCHAR, 3, '0')
                ELSE            chr(26085) || chr(26412) || chr(35486) || lpad(i::VARCHAR, 4, '0')
           END AS k,
           (i % 3)::INTEGER AS g
    FROM range(10) t(i)
) TO '{TEST_DIR}/prf_non_utf8_probe.parquet' (ROW_GROUP_SIZE 5);
