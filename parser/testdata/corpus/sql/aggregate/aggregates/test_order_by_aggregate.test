CREATE TABLE user_causes (
    user_id INT,
    cause VARCHAR,
    "date" DATE
);
--
ok
==
INSERT INTO user_causes (user_id, cause, "date") VALUES
(1, 'Environmental', '2024-03-18'),
(1, 'Environmental', '2024-02-18'),
(1, 'Health', '2024-01-18'),
(1, 'Social', '2023-12-18'),
(1, NULL, '2023-11-19');
