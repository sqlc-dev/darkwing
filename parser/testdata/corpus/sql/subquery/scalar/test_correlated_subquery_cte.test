SELECT (
    WITH nt AS (SELECT length(s) AS n)
    SELECT (
        FROM (FROM nt)
        WHERE 'a' = s[n]
    )
) AS ends_in_a
FROM unnest(['a', 'ab']) _(s);
--
ok
==
SELECT (
    WITH nt AS (SELECT length(s) AS n)
    SELECT (
        SELECT 1
        FROM (SELECT n FROM nt) t
        WHERE 'a' = s[n]
    )
) AS ends_in_a
FROM unnest(['a', 'ab']) _(s);
--
ok
==
SELECT (
  WITH nt AS (SELECT length(s) AS n)
  SELECT (
    FROM (FROM nt)
    WHERE 'a' = s[n]
  )
) AS ends_in_a
FROM unnest(['a','ab','ba']) _(s)
ORDER BY ALL;
--
ok
==
SELECT
  (
    WITH nt AS (SELECT length(s) AS n)
    SELECT (FROM (FROM nt) WHERE 'a' = s[n])
  ) AS a1,
  (
    WITH nt AS (SELECT length(s) AS n)
    SELECT (FROM (FROM nt) WHERE 'a' = s[n])
  ) AS a2
FROM unnest(['a','ab']) _(s);
--
ok
