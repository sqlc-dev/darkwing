CREATE TABLE events (key INTEGER, begin DOUBLE, value INTEGER);
--
ok
==
INSERT INTO events VALUES
	(1, 1, 0),
	(1, 3, 1),
	(1, 6, 2),
	(1, 8, 3),
	(2, 0, 10),
	(2, 7, 20),
	(2, 11, 30),
