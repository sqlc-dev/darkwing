COPY (
    SELECT
        [v, v + 2] AS list_value,
        [[[v, v + 2]]] AS deep_list,
        {
            'level_1': {'level_2': {'value': v}}
        } AS struct_value,
        i::BIGINT AS payload
    FROM (
        SELECT i, ((i % 100) * 2)::INTEGER AS v
        FROM range(20480) t(i)
    ) data
) TO '{TEST_DIR}/bloom_list.parquet' (
    FORMAT PARQUET,
    ROW_GROUP_SIZE 2048,
    DICTIONARY_SIZE_LIMIT 1000,
    WRITE_BLOOM_FILTER TRUE
);
--
ok
