WITH RECURSIVE outer_cte(a, b) AS (
	SELECT 1, 1
	UNION
	(
		WITH RECURSIVE inner_cte(k, v) USING KEY (k) AS (
			SELECT a, 0 FROM outer_cte WHERE b < 4
			UNION ALL
			SELECT n.k, r.v + 1
			FROM inner_cte n
			JOIN recurring.inner_cte r USING (k)
			WHERE n.v < 1
		)
		SELECT k, b + 1
		FROM inner_cte, outer_cte
		WHERE v = 1 AND b < 4
	)
)
SELECT * FROM outer_cte;
