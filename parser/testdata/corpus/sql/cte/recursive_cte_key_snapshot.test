WITH RECURSIVE t(k, v) USING KEY (k) AS (
	SELECT 1, 0
	UNION ALL
	SELECT n.k, r.v + 1
	FROM t n
	JOIN recurring.t r USING (k)
	WHERE n.v < 3
)
SELECT k, v FROM t;
--
ok
==
