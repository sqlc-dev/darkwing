CREATE TABLE lttb_states AS
SELECT lttb(x::DOUBLE, y::DOUBLE, 3) EXPORT_STATE AS st
FROM (SELECT i x, (i * i)::DOUBLE y FROM range(10) t(i)) WHERE false;
