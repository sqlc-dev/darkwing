SELECT
	id,
	LEAD(x ORDER BY x DESC, id ASC, id ASC) OVER w1,
	LEAD(x, 2 ORDER BY x DESC, id ASC, id ASC) OVER w1,
	LEAD(x, 0 ORDER BY x DESC, id ASC, id ASC) OVER w1,
	LAG(x ORDER BY x DESC, id ASC, id ASC) OVER w1,
	LEAD(x ORDER BY x DESC, id ASC, id ASC) OVER w2,
	LAG(x ORDER BY x DESC, id ASC, id ASC) OVER w2,
	LEAD(x ORDER BY x DESC, id ASC, id ASC) OVER w3,
	LAG(x, 2 ORDER BY x DESC, id ASC, id ASC) OVER w3
FROM leadlag_frames
WINDOW w1 AS (ORDER BY x DESC, id ASC ROWS BETWEEN 1 FOLLOWING AND UNBOUNDED FOLLOWING),
       w2 AS (ORDER BY x DESC, id ASC ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING),
       w3 AS (ORDER BY x DESC, id ASC ROWS BETWEEN 2 FOLLOWING AND 4 FOLLOWING)
ORDER BY id;
--
ok
==
SELECT
	id,
	LEAD(x ORDER BY x DESC, id ASC) OVER w1,
	LEAD(x, 2 ORDER BY x DESC, id ASC) OVER w1,
	LEAD(x, 0 ORDER BY x DESC, id ASC) OVER w1,
	LAG(x ORDER BY x DESC, id ASC) OVER w1,
	LEAD(x ORDER BY x DESC, id ASC) OVER w2,
	LAG(x ORDER BY x DESC, id ASC) OVER w2,
	LEAD(x ORDER BY x DESC, id ASC) OVER w3,
	LAG(x, 2 ORDER BY x DESC, id ASC) OVER w3
FROM leadlag_frames
WINDOW w1 AS (ORDER BY x DESC, id ASC ROWS BETWEEN 1 FOLLOWING AND UNBOUNDED FOLLOWING),
       w2 AS (ORDER BY x DESC, id ASC ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING),
       w3 AS (ORDER BY x DESC, id ASC ROWS BETWEEN 2 FOLLOWING AND 4 FOLLOWING)
ORDER BY id;
