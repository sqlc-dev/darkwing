SELECT count(*)
FROM posts AS ref_0
WHERE EXISTS (
	SELECT 1
	FROM (
		SELECT
			ref_0.id AS c0,
			ref_1.views AS c1,
			ref_1.views AS c2
		FROM posts AS ref_1
		WHERE ref_0.likes > ref_1.likes
	) AS subq_0
	WHERE subq_0.c1 != ref_0.likes
);
