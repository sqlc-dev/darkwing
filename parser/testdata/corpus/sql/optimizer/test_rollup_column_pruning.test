EXPLAIN WITH limited AS (
    SELECT col1, col2 FROM events WHERE col3 = 1 LIMIT 10
)
SELECT e.col1, COUNT(*) 
FROM events e
WHERE e.col1 IN (SELECT col1 FROM limited)
GROUP BY ROLLUP(e.col1);
