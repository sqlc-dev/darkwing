CREATE TABLE sales AS
SELECT i AS id,
       DATE '2024-01-15' + (i * 20)::INTEGER AS d,
       CASE i % 3 WHEN 0 THEN 'eu' WHEN 1 THEN 'us' ELSE NULL END AS region
FROM range(10) t(i);
--
ok
==
COPY sales TO '{TEST_DIR}/partition_path_case' (FORMAT parquet, PARTITION_BY (region),
PARTITION_PATH CASE WHEN region = 'eu' THEN 'europe' ELSE 'region=' || coalesce(region, 'unknown') END);
--
ok
==
SELECT regexp_extract(replace(filename, '\', '/'), 'partition_path_case/(.*)/[^/]*$', 1) AS dir, count(*)
FROM read_parquet('{TEST_DIR}/partition_path_case/**/*.parquet', hive_partitioning = false)
GROUP BY dir ORDER BY dir;
--
ok
==
COPY (SELECT *, year(d) AS y, month(d) AS m FROM sales) TO '{TEST_DIR}/partition_path_date' (FORMAT parquet,
PARTITION_BY (y, m), PARTITION_PATH format('{}/{:02d}', y, m));
--
ok
==
SELECT dir, count(*), count(DISTINCT filename) FROM (
	SELECT regexp_extract(replace(filename, '\', '/'), 'partition_path_date/(.*)/[^/]*$', 1) AS dir, filename
	FROM read_parquet('{TEST_DIR}/partition_path_date/*/*/*.parquet', hive_partitioning = false)
) GROUP BY dir ORDER BY dir;
--
ok
==
