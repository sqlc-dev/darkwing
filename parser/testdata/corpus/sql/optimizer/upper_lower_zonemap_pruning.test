CREATE TABLE case_pruning AS
SELECT i::INTEGER AS i, CASE WHEN i < 2048 THEN 'alpha' WHEN i < 4096 THEN 'Beta' ELSE 'GAMMA' END AS s
FROM range(6144) r(i);
