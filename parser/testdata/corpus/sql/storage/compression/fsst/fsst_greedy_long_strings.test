SELECT count(*), count(*) FILTER (
	WHERE s = repeat('x', 510) || 'abcdefghij' || lpad(i::VARCHAR, 8, '0'))
FROM (SELECT row_number() OVER (ORDER BY s) - 1 AS i, s FROM db.t);
