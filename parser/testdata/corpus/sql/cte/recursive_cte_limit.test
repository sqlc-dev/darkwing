WITH RECURSIVE t(i) AS (
	SELECT 0
	UNION ALL
	SELECT i + 1 FROM t
)
SELECT i FROM t WHERE i % 2000 = 0 LIMIT 10;
--
ok
==
WITH RECURSIVE
	"@loop" ("$label", "$output", "0") AS (
		(SELECT '$'::VARCHAR AS "$label", NULL::BIGINT AS "$output", NULL::BIGINT AS "0")
		UNION ALL
		(WITH
			"0" AS (SELECT NULL FROM "@loop" WHERE "$label" IS NOT DISTINCT FROM '$'),
			"1" (i) AS (SELECT 0 AS i FROM "0"),
			"2" (i) AS (SELECT "0" AS i FROM "@loop" WHERE "$label" IS NOT DISTINCT FROM '$loop0'),
			"3" (i) AS (
				SELECT i FROM "1"
				UNION ALL
				SELECT i FROM "2"
			),
			"4" (i) AS (SELECT (i + 1) % 1000 AS i FROM "3"),
			"5" ("$output") AS (SELECT i FROM "4"),
			"6" ("$label", i) AS (SELECT '$loop0', i FROM "4")
			SELECT NULL::VARCHAR, "$output"::BIGINT, NULL::BIGINT FROM "5"
			UNION ALL
			SELECT "$label"::VARCHAR, NULL::BIGINT, i::BIGINT FROM "6"
		)
	)
SELECT "$output" FROM "@loop" WHERE "$label" IS NULL LIMIT 10;
--
ok
==
SELECT count(*) FROM (
	WITH RECURSIVE t(i) AS (
		SELECT 0
		UNION ALL
		SELECT i + 1 FROM t
	)
	SELECT i FROM t LIMIT 2048
);
--
ok
