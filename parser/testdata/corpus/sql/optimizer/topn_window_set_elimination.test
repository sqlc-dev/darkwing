FROM (
    VALUES
        (timestamp '2026-03-25 05:33:11.822+08', 10),
        (timestamp '2026-03-26 05:33:11.822+08', 15),
        (timestamp '2026-03-27 05:33:11.822+08', 12),
        (timestamp '2026-03-28 05:33:11.822+08', 18),
        (timestamp '2026-03-29 05:33:11.822+08', 14)
) AS t(date, value);
--
ok
