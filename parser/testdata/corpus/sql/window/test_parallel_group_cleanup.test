SELECT CASE WHEN p = 128 AND len(items) > 0 THEN error('window cleanup cancellation') ELSE len(items) END
FROM (
    SELECT p, list(s) OVER (PARTITION BY p ORDER BY j ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING) AS items
    FROM cleanup_input
) t
