SELECT name, field
FROM duckdb_secrets(), UNNEST(string_split(secret_string, ';')) AS fields(field)
WHERE name IN ('http_header_redaction_config', 'http_header_redaction_env')
  AND split_part(field, '=', 1) IN ('extra_http_headers', 'bearer_token', 'http_proxy_password', 'verify_ssl');
