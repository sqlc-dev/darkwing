select count(*)
from (
    select g, variant_group_object(k, v) as obj
    from (values
        (1, 'z', 10::VARIANT),
        (1, 'a', 20::VARIANT),
        (2, 'a', 30::VARIANT)
    ) t(g, k, v)
    group by g
) grouped
where (g = 1 and variant_comparator(obj) = variant_comparator({'a': 20, 'z': 10}::VARIANT))
   or (g = 2 and variant_comparator(obj) = variant_comparator({'a': 30}::VARIANT));
--
ok
