CREATE TABLE db1.wide_tbl AS SELECT
    i AS id,
    md5(i::VARCHAR || 'c0') AS c0,
    md5(i::VARCHAR || 'c1') AS c1,
    md5(i::VARCHAR || 'c2') AS c2,
    md5(i::VARCHAR || 'c3') AS c3,
    md5(i::VARCHAR || 'c4') AS c4,
    md5(i::VARCHAR || 'c5') AS c5
FROM range(50000) t(i)
--
ok
