CREATE TABLE parallel_build_edges AS
SELECT i AS src, i + 1 AS dst FROM range(491520) t(i);
--
ok
==
WITH RECURSIVE walk(node, depth) AS (
	SELECT 0::BIGINT, 0
	UNION ALL
	SELECT e.dst, w.depth + 1
	FROM walk w
	JOIN parallel_build_edges e ON e.src = w.node
	WHERE w.depth < 2
)
SELECT count(*), max(depth), sum(node) FROM walk;
--
ok
