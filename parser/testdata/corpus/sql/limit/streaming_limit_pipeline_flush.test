SELECT o.o_orderkey
FROM (
    SELECT l.o_orderkey
    FROM orders l
    LEFT JOIN lineitem li ON li.l_orderkey = l.o_orderkey
    WHERE l.o_orderkey = 1
    LIMIT 1
) AS filtered
JOIN orders o ON TRUE
WHERE o.o_orderkey = 1;
