CREATE TABLE dictionary_inputs AS
SELECT i, (i//64)%8 AS g, CASE WHEN i%7=0 THEN i%101-50 END::INTEGER AS v
FROM range(16513) t(i);
--
ok
==
CREATE TABLE flat_inputs AS SELECT * FROM dictionary_inputs WHERE i%3<>0;
--
ok
==
WITH a AS (
    SELECT g, sum(v) AS s, min(v) AS lo, max(v) AS hi, bit_xor(v) AS bits
    FROM dictionary_inputs WHERE i%3<>0 GROUP BY g
), b AS (
    SELECT g, sum(v) AS s, min(v) AS lo, max(v) AS hi, bit_xor(v) AS bits
    FROM flat_inputs GROUP BY g
)
SELECT count(*) FROM (
    (TABLE a EXCEPT ALL TABLE b)
    UNION ALL
    (TABLE b EXCEPT ALL TABLE a)
);
