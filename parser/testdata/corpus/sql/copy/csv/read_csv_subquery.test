WITH urls AS (
	SELECT 'a.csv' AS url UNION ALL SELECT 'b.csv'
)
SELECT *
FROM read_csv_auto((SELECT url FROM urls LIMIT 3), delim=',')
WHERE properties.height > -1.0
LIMIT 10
