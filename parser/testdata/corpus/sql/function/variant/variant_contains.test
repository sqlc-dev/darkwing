	(1, '{"a": 1}'::JSON::VARIANT, '{"a": 1}'::JSON::VARIANT),
	(2, '{"a": 1}'::JSON::VARIANT, '{"b": 1}'::JSON::VARIANT),
	(3, '[1, 2, 3]'::JSON::VARIANT, 2::VARIANT),
	(4, '[1, 2, 3]'::JSON::VARIANT, 4::VARIANT),
	(5, NULL::VARIANT, 1::VARIANT),
	(6, '{"a": 1}'::JSON::VARIANT, NULL::VARIANT);
