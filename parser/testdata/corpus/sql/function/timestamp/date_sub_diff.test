	date_sub('month', TIMESTAMP '2004-02-29 13:00:00', TIMESTAMP '2004-01-31 12:00:00'),
	date_sub('day', DATE '-infinity', DATE '2000-01-01') IS NULL,
	date_diff('day', DATE '2000-01-01', DATE 'infinity') IS NULL;
