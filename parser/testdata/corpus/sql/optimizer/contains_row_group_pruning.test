CREATE TABLE t AS
    SELECT CASE
        WHEN range < 2048 THEN 'apple_' || range::VARCHAR
        WHEN range < 4096 THEN 'duckdb'
        ELSE 'zebra_' || range::VARCHAR END AS s
    FROM range(6144);
