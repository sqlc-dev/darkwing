CREATE TABLE list_variants AS
SELECT * FROM (VALUES
    (0, NULL::VARIANT),
    (1, []::INTEGER[]::VARIANT),
    (2, [NULL]::INTEGER[]::VARIANT),
    (3, [1, NULL]::VARIANT),
    (4, 'fallback'::VARIANT)
) t(id, v);
--
ok
==
WITH stats AS (
    COPY list_variants TO '{TEST_DIR}/variant_list_stats.parquet'
    (SHREDDING {v: 'INTEGER[]'}, RETURN_STATS)
)
SELECT entry.key, entry.value
FROM stats, UNNEST(map_entries(column_statistics)) t(entry)
WHERE NOT map_contains(entry.value, 'column_size_bytes');
--
ok
==
WITH stats AS (
    COPY (SELECT v FROM list_variants WHERE id < 4)
    TO '{TEST_DIR}/variant_fully_shredded_list_stats.parquet'
    (SHREDDING {v: 'INTEGER[]'}, RETURN_STATS)
)
SELECT column_statistics['"v"'], column_statistics['"v"."typed_value"'],
       column_statistics['"v"."value"']['null_count'] = column_statistics['"v"."value"']['num_values']
FROM stats;
--
ok
==
