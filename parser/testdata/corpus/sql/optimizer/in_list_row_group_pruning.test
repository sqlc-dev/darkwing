EXPLAIN ANALYZE SELECT sum(payload) FROM strings WHERE s <> 'v000000' AND s <> 'v000010';
--
ok
==
EXPLAIN ANALYZE SELECT sum(payload) FROM strings WHERE s NOT IN ('v000000', 'v000010');
--
ok
