CREATE TABLE figure1 AS 
	SELECT * 
	FROM VALUES 
			(1, 'a'),
			(2, 'b'),
			(3, 'b'),
			(4, 'c'),
			(5, 'c'),
			(6, 'b'),
			(7, 'c'),
			(8, 'a')
		v(i, s);
--
ok
==
SELECT i
	, s
	, COUNT(DISTINCT s) OVER( ORDER BY i ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING) AS c
FROM figure1
ORDER BY i
--
ok
==
SELECT i
	, s
	, COUNT(DISTINCT s) OVER( ORDER BY i ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING EXCLUDE TIES) AS c
FROM figure1
ORDER BY i
--
ok
==
SELECT 
	i // 10 AS p,
	i,
	ANY_VALUE(i ORDER BY i DESC) OVER(
		PARTITION BY i // 10
		ORDER BY i
		ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING 
	) AS c
FROM range(20) tbl(i)
ORDER BY ALL
--
ok
==
SELECT 
	i // 10 AS p,
	i,
	LIST(i ORDER BY i DESC) OVER(
		PARTITION BY i // 10
		ORDER BY i
		ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING 
	) AS c
FROM range(20) tbl(i)
ORDER BY ALL
--
ok
==
SELECT 
	i // 10 AS p,
	i,
	LIST(DISTINCT i // 2 ORDER BY i DESC) OVER(
		PARTITION BY i // 10
		ORDER BY i
		ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING 
	) AS c
FROM range(20) tbl(i)
ORDER BY ALL
--
ok
==
SELECT 
	i // 10 AS p,
	i,
	LIST(DISTINCT i // 2 ORDER BY i DESC) FILTER (i > 1) OVER(
		PARTITION BY i // 10
		ORDER BY i
		ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING 
	) AS c
FROM range(20) tbl(i)
