WITH outer_t(x) AS (SELECT 1)
SELECT q.cnt
FROM outer_t
CROSS JOIN LATERAL (
	SELECT count(*) AS cnt
	FROM (SELECT 1 AS r) e
	CROSS JOIN (SELECT 1 AS v) d
	LEFT JOIN (SELECT 1 AS r, 1 AS v) e2 ON e2.r = outer_t.x AND e2.v = d.v
) q;
