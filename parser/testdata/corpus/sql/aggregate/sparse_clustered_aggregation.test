WITH a AS (
    SELECT g, min(CASE WHEN i%7=0 THEN v END) AS lo,
           max(CASE WHEN i%7=1 THEN v END) AS hi,
           bit_xor(CASE WHEN i%7=2 THEN v::BIGINT END) AS bits
    FROM clustered_inputs GROUP BY g
), b AS (
    SELECT g, min(v) FILTER (WHERE i%7=0) AS lo,
           max(v) FILTER (WHERE i%7=1) AS hi,
           bit_xor(v::BIGINT) FILTER (WHERE i%7=2) AS bits
    FROM clustered_inputs GROUP BY g
)
SELECT count(*) FROM (
    (TABLE a EXCEPT ALL TABLE b)
    UNION ALL
    (TABLE b EXCEPT ALL TABLE a)
);
