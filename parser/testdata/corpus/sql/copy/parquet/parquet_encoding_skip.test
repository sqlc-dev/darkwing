COPY (
	SELECT CASE WHEN i < 2048 THEN ((i % 2) * 2)::INTEGER ELSE 1 END AS filter_col,
		i::FLOAT AS f, i::DOUBLE AS d,
		CASE WHEN i % 7 = 0 THEN NULL ELSE 'value_' || lpad(i::VARCHAR, 6, '0') END AS s
	FROM range(5000) t(i)
) TO '{TEST_DIR}/skip_v2_encodings.parquet' (
	FORMAT parquet, PARQUET_VERSION 'V2', ROW_GROUP_SIZE 10000, DICTIONARY_SIZE_LIMIT 1
);
--
ok
==
SELECT path_in_schema, encodings
FROM parquet_metadata('{TEST_DIR}/skip_v2_encodings.parquet')
WHERE path_in_schema IN ('f', 'd', 's')
ORDER BY path_in_schema
--
ok
==
SELECT sum(f), sum(d), sum(length(s))
FROM read_parquet('{TEST_DIR}/skip_v2_encodings.parquet')
WHERE filter_col = 1
