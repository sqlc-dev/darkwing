CREATE TABLE medium_list_test AS SELECT
	[i, i, i] l1,
	case when i%10=0
		then
			null
		else
			[case when i%2=0 then 100 + i else null end, null, case when i%2=0 then null else 100 + i end]
	end l2
FROM range(2500) t(i)
--
ok
