CREATE TABLE limits AS SELECT ts, label FROM (VALUES
	('290309-12-22 (BC) 00:00:00Z'::TIMESTAMPTZ, 'tsmin'),
	('294247-01-10 04:00:54.775806Z'::TIMESTAMPTZ, 'tsmax')
) tbl(ts, label);
--
ok
==
