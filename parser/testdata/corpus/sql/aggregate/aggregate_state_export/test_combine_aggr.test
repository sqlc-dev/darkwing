WITH states AS (
    SELECT
        sum(v) EXPORT_STATE AS sum_s,
        count(v) EXPORT_STATE AS count_s,
        count(*) EXPORT_STATE AS count_star_s,
        avg(v) EXPORT_STATE AS avg_s,
        min(v) EXPORT_STATE AS min_s,
        max(v) EXPORT_STATE AS max_s
    FROM (VALUES (1), (3), (5)) t(v)
)
SELECT
    finalize(combine_aggr(sum_s, 3)),
    finalize(combine_aggr(count_s, 3)),
    finalize(combine_aggr(count_star_s, 3)),
    finalize(combine_aggr(avg_s, 3))::INTEGER,
    finalize(combine_aggr(min_s, 3)),
    finalize(combine_aggr(max_s, 3))
FROM states;
--
ok
