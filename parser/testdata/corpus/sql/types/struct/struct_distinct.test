CREATE OR REPLACE VIEW struct_int AS SELECT * FROM (VALUES
	({'x': 1::{type}}, {'x': 1::{type}}),
	({'x': 1::{type}}, {'x': 2::{type}}),
	({'x': 2::{type}}, {'x': 1::{type}}),
	(NULL, {'x': 1::{type}}),
	({'x': 2::{type}}, NULL),
	(NULL, NULL)
	) tbl(l, r);
--
