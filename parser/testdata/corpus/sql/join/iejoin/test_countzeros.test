create or replace table states as
	select 
		i // 100 as k,
		'2024-01-01'::TIMESTAMP + INTERVAL (i // 1) seconds as b,
		b + INTERVAL 1 second as e,
	from range(100_000) as tbl(i);
--
ok
==
with joined as (
	select lhs.k l, rhs.k r
	from states lhs 
	inner join states rhs
	   on lhs.b < rhs.e
	  and rhs.b < lhs.e
	  and lhs.k = rhs.k
)
select count(*) 
from joined
