WITH RECURSIVE c(x) USING KEY(x) AS (SELECT (x) COLLATE nocase FROM (VALUES ('A'),('a'),(NULL))v(x) UNION SELECT x FROM c WHERE false) SELECT x FROM c ORDER BY x NULLS LAST;
