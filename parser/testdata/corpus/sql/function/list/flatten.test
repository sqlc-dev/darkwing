CREATE TABLE flatten_db.inputs AS
SELECT CASE
           WHEN i < 2048 THEN NULL::INTEGER[][]
           WHEN i < 4096 THEN [NULL::INTEGER[]]
           ELSE [[i::INTEGER]]
       END AS nested
FROM range(6144) tbl(i)
--
ok
==
SELECT count(*) FROM flatten_db.inputs WHERE flatten(nested) IS NOT NULL;
--
ok
