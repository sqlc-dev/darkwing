COPY (
	SELECT repeat('w', 1024) AS name, '2026' AS year, '07' AS month,
	       CASE WHEN i < 2048 THEN '07' ELSE '08' END AS day
	FROM range(4096) t(i)
) TO '__TEST_DIR__/boundary_partitions' (FORMAT PARQUET, PARTITION_BY (year, month, day), PRESERVE_ORDER false, ROW_GROUP_SIZE_BYTES '50MiB')
--
ok
==
SELECT day, count(*) FROM read_parquet('__TEST_DIR__/boundary_partitions/**/*.parquet', hive_partitioning = true) GROUP BY ALL ORDER BY ALL
--
ok
==
COPY (
	SELECT repeat('w', 1024) AS name, CASE WHEN i < 2048 THEN 'a' ELSE 'b' END AS part
	FROM range(4096) t(i)
) TO '__TEST_DIR__/boundary_partitions_small' (FORMAT PARQUET, PARTITION_BY (part), PRESERVE_ORDER false, ROW_GROUP_SIZE_BYTES '256KiB')
--
ok
==
SELECT part, count(*) FROM read_parquet('__TEST_DIR__/boundary_partitions_small/**/*.parquet', hive_partitioning = true) GROUP BY ALL ORDER BY ALL
--
ok
